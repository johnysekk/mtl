{
  "crons": [
    {
      "path": "/api/partner-stats-cron",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/release-cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/pairing?cron=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-attendance",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/referral-cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-purge-id",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/entity-close-cron",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/orphan-accounts-cron",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/gym-audit-prune",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/gym-referral-cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/fx-sync",
      "schedule": "30 15 * * 1-5"
    },
    {
      "path": "/api/commission-cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cohort-end-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cohort-month-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/bankai-cron",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/sub-rate-cron",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/unified-doklad-cron",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/membership-expiry-cron",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/reconcile-cash",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/circle-cron",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/provider-apply-prune",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/come-of-age-cron",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/org-rate-cron",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/prune-cron",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/doklad-backfill-cron",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/doklad-catchup-cron",
      "schedule": "50 8 * * *"
    },
    {
      "path": "/api/geo-backfill-cron",
      "schedule": "35 4 * * *"
    },
    {
      "path": "/api/demand-match-cron",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/bug-shots-prune",
      "schedule": "30 4 * * 1"
    },
    {
      "path": "/api/media-prune-cron",
      "schedule": "30 4 * * 1"
    },
    {
      "path": "/api/consent-prune-cron",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/dac7-cron",
      "schedule": "40 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/pay-commission",
      "destination": "/pay-commission.html"
    },
    {
      "source": "/club/:slug",
      "destination": "/api/club-public?slug=:slug"
    },
    {
      "source": "/coach/:slug",
      "destination": "/api/coach-public?slug=:slug"
    },
    {
      "source": "/club/:owner/course/:slug",
      "destination": "/api/share-page?ok=club&owner=:owner&kind=course&slug=:slug"
    },
    {
      "source": "/club/:owner/event/:slug",
      "destination": "/api/share-page?ok=club&owner=:owner&kind=event&slug=:slug"
    },
    {
      "source": "/coach/:owner/event/:slug",
      "destination": "/api/share-page?ok=coach&owner=:owner&kind=event&slug=:slug"
    },
    {
      "source": "/organization/:owner/event/:slug",
      "destination": "/api/share-page?ok=organization&owner=:owner&kind=event&slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
